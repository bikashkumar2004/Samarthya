{
    "type": "Settings",
    "audio": {
        "input": {
            "encoding": "mulaw",
            "sample_rate": 8000
        },
        "output": {
            "encoding": "mulaw",
            "sample_rate": 8000,
            "container": "none"
        }
    },
    "agent": {
        "language": "en",
        "listen": {
            "provider": {
                "type": "deepgram",
                "model": "nova-3",
                "keyterms": [
                    "hello", "goodbye", "paracetamol", "crocin", "dolo", "calpol", "fever", "cold",
                    "headache", "cough", "syrup", "aspirin", "ibuprofen", "advil", "tylenol",
                    "acetaminophen", "tramadol", "amoxicillin", "cetirizine", "omeprazole",
                    "metformin", "medicine", "tablets", "prescription", "order", "delivery", "price"
                ]
            }
        },
        "think": {
            "provider": {
                "type": "open_ai",
                "model": "gpt-4o-mini",
                "temperature": 0.3
            },
            "prompt": "You are a professional pharmacy AI assistant for Whitespace Pharmacy. You can: 1) Search our knowledge base using search_knowledge_base to answer questions about medications, dosages, indications, side effects, prices, prescriptions, FAQs, and delivery policies. 2) Place medication orders with place_order. 3) Look up existing orders with lookup_order. IMPORTANT: Always confirm full customer name, medication name, and quantity before placing orders. Be polite, concise, and helpful.",
            "functions": [
                {
                    "name": "search_knowledge_base",
                    "description": "Searches the pharmacy knowledge base for medication details, indications, dosages, side effects, prices, prescription rules, delivery options, and store policies.",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "query": {
                                "type": "string",
                                "description": "Search query or customer question"
                            }
                        },
                        "required": ["query"]
                    }
                },
                {
                    "name": "place_order",
                    "description": "Places a medication order for a customer.",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "customer_name": {
                                "type": "string",
                                "description": "Full name of the customer"
                            },
                            "drug_name": {
                                "type": "string",
                                "description": "Name of the medication requested"
                            },
                            "quantity": {
                                "type": "integer",
                                "description": "Number of units requested"
                            }
                        },
                        "required": ["customer_name", "drug_name"]
                    }
                },
                {
                    "name": "lookup_order",
                    "description": "Retrieves the status and details of an existing order by its Order ID.",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "order_id": {
                                "type": "integer",
                                "description": "The numeric Order ID"
                            }
                        },
                        "required": ["order_id"]
                    }
                }
            ]
        },
        "speak": {
            "provider": {
                "type": "deepgram",
                "model": "aura-2-thalia-en"
            }
        },
        "greeting": "How can I assist you?"
    }
}