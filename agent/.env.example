# Deepgram API Key (for Speech-to-Speech agent)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/whitespace-crm?retryWrites=true&w=majority
MONGODB_DB=whitespace-crm

# Hugging Face API Token (for call summary and sentiment analysis)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Agent WebSocket Server settings
AGENT_HOST=localhost
AGENT_PORT=5000
